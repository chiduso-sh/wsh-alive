# Copy to .env.local and fill in. Set the same variables in Vercel.

# Chat assistant (Gemini: https://aistudio.google.com/apikey). Server-only: never prefix with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=your_key_here
# Optional: Gemini model id. Defaults to gemini-flash-lite-latest.
GEMINI_MODEL=

# Newsletter (Resend: https://resend.com/api-keys). Server-only.
RESEND_API_KEY=re_your_key_here
# Sender on a domain verified in Resend. Without it, mail comes from
# onboarding@resend.dev, which only delivers to your own Resend account email.
RESEND_FROM="WSH Alive <hello@your-domain.com>"
# Optional: Resend segment that confirmed subscribers are added to.
RESEND_SEGMENT_ID=
# Signs confirm/unsubscribe links. 32+ random characters, e.g.: openssl rand -base64 32
NEWSLETTER_SECRET=
# Origin used in email links. Leave empty locally (falls back to http://localhost:3000);
# on Vercel it defaults to the production URL.
SITE_URL=
