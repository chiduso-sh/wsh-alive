# Copy to .env.local and fill in. Set the same variables in Vercel.

# EngageAI (https://dashboard.engageai.tech -> API Keys). Server-only: never prefix with NEXT_PUBLIC_.
ENGAGEAI_API_KEY=eai_your_key_here
# Must match the app the key was created for in the EngageAI dashboard.
ENGAGEAI_APP_ID=wsh_alive

# Resend (newsletter, not wired yet)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
